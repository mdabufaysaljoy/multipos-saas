# ---------------------------------------------------------------------------
# Copy to .env (repo root is fine - server reads ../.env and ./.env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100

# MongoDB ------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/clothing_pos
# `npm test` runs against its own database and drops it again when finished.
# Derived from MONGODB_URI by appending "_test" unless set explicitly here.
# The name must contain "test" or the runner refuses to clean up.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/clothing_pos_test
# Set KEEP_TEST_DB=true to preserve it after a run for debugging.

# Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_value
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

# CORS ---------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173

# Storage ------------------------------------------------------------------
# local | s3 | cloudinary   (only "local" is implemented in phase 1)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4100

# Platform defaults --------------------------------------------------------
DEFAULT_CURRENCY=BDT
# Free-trial length in days. Seeded onto the Starter plan, which is the ONLY
# plan that offers a trial; the paid tiers carry 0. The plan value is what the
# server actually uses, so change it in Platform -> Plans after the first seed.
TRIAL_DAYS=7
# Self-serve ceiling on POS workspaces one platform account may open (1-100).
MAX_WORKSPACES_PER_ACCOUNT=10

# Payment providers (phase 2 - leave blank in development) -----------------
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta   Live: https://tokenized.pay.bka.sh/v1.2.0-beta
# Prove a new setup with docs/bkash-sandbox.md and `npm run bkash:sandbox -w server`.
# The customer returns to PUBLIC_BASE_URL/api/payments/callback/bkash, so
# PUBLIC_BASE_URL must be the API's public https address in production.
BKASH_BASE_URL=
# bKash payment notifications arrive through Amazon SNS. Only messages from this
# topic, with a valid AWS signature, are accepted - and each one only triggers a
# status check against the bKash API; nothing in a notification is trusted.
BKASH_WEBHOOK_TOPIC_ARN=

NAGAD_MERCHANT_ID=
NAGAD_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_BASE_URL=
NAGAD_WEBHOOK_SECRET=

# SMS - Alpha SMS (sms.net.bd) ---------------------------------------------
# FIRST-INSTALL DEFAULTS ONLY. Gateway credentials now live in the database so a
# platform admin can rotate them without a redeploy (Platform -> Integrations).
# These values are copied in on first seed, or by:
#     npm run migrate:sms-credentials -w server
# After that the database is authoritative and changing these has no effect.
ALPHA_SMS_API_KEY=
ALPHA_SMS_BASE_URL=https://api.sms.net.bd
ALPHA_SMS_SENDER_ID=
# Development-only test double. Exercises the billing path WITHOUT delivering
# any message. Ignored entirely when NODE_ENV=production.
SMS_MOCK_ENABLED=false

# Seed credentials (development only) --------------------------------------
SEED_PLATFORM_ADMIN_EMAIL=platform@pos.dev
SEED_PLATFORM_ADMIN_PASSWORD=Platform@123
SEED_TENANT_ADMIN_EMAIL=admin@demostore.dev
SEED_TENANT_ADMIN_PASSWORD=Admin@123
SEED_STAFF_EMAIL=cashier@demostore.dev
SEED_STAFF_PASSWORD=Cashier@123

# Branding used in transactional emails (invoices, renewal confirmations, expiry reminders).
BRAND_NAME=RetailSuite
BRAND_WEBSITE_URL=https://retailersuites.com
BRAND_PRIMARY_COLOR=#2056d5
# Dates in emails are shown in this timezone.
BUSINESS_TIMEZONE=Asia/Dhaka

# QZ Tray direct printing - request signing (server only, never commit the key).
# Leave unset in development: QZ Tray then asks the cashier to allow the site.
# See docs/PRINTING_ARCHITECTURE.md §4.
# QZ_CERTIFICATE_PATH=/etc/retailersuites/qz/digital-certificate.txt
# QZ_PRIVATE_KEY_PATH=/etc/retailersuites/qz/private-key.pem

# Email - SMTP --------------------------------------------------------------
# Not read from the environment at all. SMTP is configured by a platform admin
# at Platform -> Integrations and stored in the database, with the password
# write-only. Listed here only so its absence is not mistaken for an omission.

# UddoktaPay hosted checkout. Sandbox base: https://sandbox.uddoktapay.com
# Production is the merchant's own UddoktaPay installation origin.
UDDOKTAPAY_BASE_URL=
UDDOKTAPAY_API_KEY=
