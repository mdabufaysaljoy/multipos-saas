# ---------------------------------------------------------------------------
# Production configuration for a single VPS.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   # fill in every REQUIRED value, then: deploy/validate.sh
#
# This file is gitignored and must never be committed. It is the only place
# production secrets live on the server; nothing is baked into an image.
#
# Most integration credentials are NOT here: payment gateways, SMTP and the SMS
# gateway are configured by a platform admin and stored in the database, so
# there is nothing to put in this file and nothing to leak into a layer.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# ---- REQUIRED: image revision --------------------------------------------
# A git revision, never "latest". deploy/*.sh set this for you from
# `git rev-parse --short HEAD`; it is listed here so a manual
# `docker compose -f docker-compose.prod.yml` call also works.
# IMAGE_TAG=abc1234

# ---- REQUIRED: database ---------------------------------------------------
# Atlas (Strategy A, the default). It must be a replica set - this application
# opens transactions, and a standalone server silently disables them.
# Create a dedicated database user with readWrite on this database only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/retailersuites?retryWrites=true&w=majority
#
# Self-hosted (Strategy B) - only with docker-compose.prod.mongo.yml:
# MONGODB_URI=mongodb://mongo:27017/retailersuites?replicaSet=rs0

# ---- REQUIRED: secrets ----------------------------------------------------
# Generate fresh values ON THE SERVER, and never reuse the development ones:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# At least 32 characters each, and the two must differ. The server refuses to
# boot otherwise. Rotating either one signs every user out; see the rotation
# note in docs/VPS_DEPLOYMENT.md.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

# ---- REQUIRED: origins and proxying --------------------------------------
# Where a browser reaches the app. ONE origin: nginx serves the SPA and proxies
# /api, so the SPA's relative /api needs no CORS at all.
#
# Phase 8 (HTTP, by IP):      http://203.0.113.10
# Phase 9 (HTTPS, by domain): https://app.example.com
CLIENT_ORIGIN=http://REPLACE_WITH_SERVER_IP
# Used to build public URLs for uploaded files. Must match how a browser
# actually reaches the API, which through nginx is the same origin as the app.
PUBLIC_BASE_URL=http://REPLACE_WITH_SERVER_IP

# How many reverse proxies sit in front of the API. This decides what the
# server believes the client's IP is, and that IP is what nearly every rate
# limiter counts against - so it is a security setting.
#   1  nginx only (Phase 8)
#   2  Cloudflare in front of nginx (Phase 9)
# Too high lets a client spoof its address and mint itself a fresh rate-limit
# bucket; too low throttles every visitor against one shared bucket.
TRUST_PROXY_HOPS=1

# ---- Business configuration ----------------------------------------------
# This decides when a sales day starts and ends. Business-day boundaries are
# computed from the PROCESS clock, so this value is applied as the containers'
# TZ. A tenant in another timezone would get the wrong day boundary - see the
# limitation in docs/VPS_DEPLOYMENT.md.
BUSINESS_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT
TRIAL_DAYS=7
MAX_WORKSPACES_PER_ACCOUNT=10
BRAND_NAME=RetailSuite
BRAND_WEBSITE_URL=https://retailersuites.com
INVOICE_ISSUER_NAME=RetailSuite
INVOICE_ISSUER_ADDRESS=

# ---- Redis ----------------------------------------------------------------
# REDIS_URL is set by docker-compose.prod.yml to the internal service name.
# This only namespaces the keys; change it and every rate-limit counter and
# queue starts fresh.
REDIS_KEY_PREFIX=retailersuites:prod

# ---- Storage --------------------------------------------------------------
# Relative to the container's working directory, so /app/server/uploads - the
# path the `uploads` volume is mounted on. Only "local" is implemented; the
# server refuses to start in production if this says s3 or cloudinary.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

# ---- Resource budget (4 GB VPS, Atlas) ------------------------------------
# Container limits are ceilings that stop one service starving the others.
# The *_HEAP_MB values are Node's own heap and must stay BELOW the container
# limit, or the kernel OOM-kills the process instead of letting V8 collect.
API_MEM_LIMIT=1280m
API_HEAP_MB=896
WORKER_MEM_LIMIT=640m
WORKER_HEAP_MB=448
REDIS_MEM_LIMIT=320m
REDIS_MAXMEMORY=256mb
WEB_MEM_LIMIT=128m

# Where nginx listens on the host. Keep 80 for Phase 8; Phase 9 adds 443.
WEB_PORT=80
WEB_BIND=0.0.0.0

# ---- Seeding --------------------------------------------------------------
# DELIBERATELY ABSENT. These variables have working defaults, and an EMPTY one
# is worse than a missing one: the environment schema validates
# SEED_*_EMAIL as an email address, so `SEED_STAFF_EMAIL=` with nothing after
# it makes the server refuse to boot. (Found exactly that way, deploying this
# file as written.)
#
# A production deployment should not carry seed credentials at all. If you need
# to seed a brand-new database once, set them temporarily - with real values -
# run the seed, then remove them again and change the passwords:
#
#   SEED_PLATFORM_ADMIN_EMAIL=you@example.com
#   SEED_PLATFORM_ADMIN_PASSWORD=<a strong password>
#   docker compose -f docker-compose.prod.yml exec api node dist/seed/seed.js
#
# `seed.js --reset` WIPES EVERY COLLECTION. Never run it against a database
# that holds real data.

# ---- Development-only switches: must stay off ----------------------------
# The SMS test double. The application ignores it when NODE_ENV=production,
# and it is listed here only so its absence is not mistaken for an omission.
SMS_MOCK_ENABLED=false
