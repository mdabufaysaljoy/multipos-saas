# ---------------------------------------------------------------------------
# Compose configuration.  cp .env.compose.example .env.compose  and edit.
#
# Only the three secrets below have to be filled in; everything else has a
# working default for a local stack. MONGODB_URI and REDIS_URL are NOT here:
# docker-compose.yml sets them to the internal service names, because a
# container's own localhost is itself.
#
# Never commit .env.compose. Never put real production credentials in it.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# The port nginx is published on. The app is then at http://localhost:8080
WEB_PORT=8080

# Database name inside the replica set.
MONGO_DB=retailersuites

# Secrets ------------------------------------------------------------------
# Generate real ones, even locally:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters each, and the two must differ. The server refuses to
# boot otherwise.
JWT_ACCESS_SECRET=replace_me_with_48_random_bytes_hex_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_48_random_bytes_hex_value

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

# Origins and proxying -----------------------------------------------------
# Same origin as nginx, so the SPA's relative /api needs no CORS at all.
CLIENT_ORIGIN=http://localhost:8080
# Used to build public URLs for uploaded files; must be how a browser reaches
# the API, which through nginx is the same origin as the app.
PUBLIC_BASE_URL=http://localhost:8080

# ONE proxy sits in front of the API in this stack: nginx. This decides what
# the server believes the client's IP is, and that IP is what nearly every rate
# limiter counts against. Adding Cloudflare in front later makes this 2.
TRUST_PROXY_HOPS=1

# Redis --------------------------------------------------------------------
# REDIS_URL is set by docker-compose.yml. This only namespaces the keys.
REDIS_KEY_PREFIX=retailersuites:compose

# Storage ------------------------------------------------------------------
# Relative to the working directory inside the container, so this is
# /app/server/uploads - the path the `uploads` volume is mounted on.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

# Platform defaults --------------------------------------------------------
DEFAULT_CURRENCY=BDT
TRIAL_DAYS=7
MAX_WORKSPACES_PER_ACCOUNT=10
BRAND_NAME=RetailSuite
BRAND_WEBSITE_URL=https://retailersuites.com
BUSINESS_TIMEZONE=Asia/Dhaka

# Seed credentials ---------------------------------------------------------
# Used only by `node dist/seed/seed.js`. Change them before exposing the stack
# to anything but your own machine.
SEED_PLATFORM_ADMIN_EMAIL=platform@pos.dev
SEED_PLATFORM_ADMIN_PASSWORD=Platform@123
SEED_TENANT_ADMIN_EMAIL=admin@demostore.dev
SEED_TENANT_ADMIN_PASSWORD=Admin@123
SEED_STAFF_EMAIL=cashier@demostore.dev
SEED_STAFF_PASSWORD=Cashier@123

# Integrations -------------------------------------------------------------
# Payment, SMS and SMTP credentials are NOT environment variables in this
# application: a platform admin stores them in the database, so there is
# nothing to put here and nothing to leak into an image.
#
# Development-only SMS test double. Ignored when NODE_ENV=production, which is
# why the integration-test override sets NODE_ENV=development.
SMS_MOCK_ENABLED=false
