{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:plan-limits": "tsx src/migrations/backfillPlanLimits.ts",
    "migrate:storage-ledger": "tsx src/migrations/backfillStorageLedger.ts",
    "migrate:sms-credentials": "tsx src/migrations/migrateSmsCredentials.ts",
    "migrate:subscription-storage": "tsx src/migrations/syncSubscriptionStorageLimits.ts",
    "migrate:plan-packages": "tsx src/migrations/syncPlanPackages.ts",
    "migrate:accounts": "tsx src/migrations/backfillAccounts.ts",
    "migrate:wallets": "tsx src/migrations/migrateAccountWallets.ts",
    "migrate:payment-review": "tsx src/migrations/backfillPaymentReview.ts",
    "migrate:pos-catalog": "tsx src/migrations/backfillPosCatalog.ts",
    "migrate:pricing-catalog": "tsx src/migrations/backfillPricingCatalog.ts",
    "migrate:workspace-subscriptions": "tsx src/migrations/backfillWorkspaceSubscriptions.ts",
    "migrate:invoices": "tsx src/migrations/backfillInvoices.ts",
    "migrate:receipts": "tsx src/migrations/backfillReceipts.ts",
    "migrate:wallet-ledger": "tsx src/migrations/backfillWalletLedger.ts",
    "migrate:wallet-sequences": "tsx src/migrations/backfillWalletSequences.ts",
    "migrate:loyalty": "tsx src/migrations/enableLoyaltyProgram.ts",
    "migrate:out-of-stock-permission": "tsx src/migrations/grantOutOfStockPermission.ts",
    "migrate:export-permission": "tsx src/migrations/grantExportPermission.ts",
    "migrate:product-import": "tsx src/migrations/enableProductImport.ts",
    "migrate:suppliers": "tsx src/migrations/enableSupplierManagement.ts",
    "migrate:verify-clothing": "tsx src/migrations/verifyClothingMigration.ts",
    "report:identities": "tsx src/migrations/reportDuplicateIdentities.ts",
    "bkash:sandbox": "tsx src/scripts/bkashSandboxCheck.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^2.36.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
