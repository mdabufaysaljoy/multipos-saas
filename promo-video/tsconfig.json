{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["es2015"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    // `generate-voiceover.ts` runs under `node --strip-types`, which resolves
    // the real file and so needs the `.ts` suffix on its import.
    "allowImportingTsExtensions": true
  },
  "exclude": ["remotion.config.ts"]
}
